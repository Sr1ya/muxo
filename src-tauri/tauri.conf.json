{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muxo",
  "identifier": "com.muxo.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Muxo",
        "width": 760,
        "height": 640,
        "minWidth": 720,
        "minHeight": 620,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Combine your internet connections for faster downloads",
    "copyright": "Copyright © 2026 Anmol Kapil",
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["torrent"], "name": "Torrent", "mimeType": "application/x-bittorrent", "role": "Viewer" }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["muxo", "magnet"] }
    }
  }
}
